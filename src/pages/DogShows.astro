---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/point-schedule.css'
import '../styles/dog-shows.css'
import { loadDogShowsData } from '../lib/dogShowsServer'
import { loadPointScheduleData } from '../lib/pointScheduleServer'
import { stateToDivision, STATE_ABBREVIATIONS } from '../lib/pointSchedule2026'
import DogShowsMap, {
  type DivisionSummary,
} from '../islands/dog-shows/DogShowsMap'

const data = loadDogShowsData()
const scheduleData = loadPointScheduleData()
const stateDivision = stateToDivision(scheduleData)

const ABBREVIATION_TO_STATE: Record<string, string> = Object.fromEntries(
  Object.entries(STATE_ABBREVIATIONS).map(([full, abbr]) => [abbr, full]),
)

// Illinois's division — 7Sisters is Illinois-based, so default the map to
// the region that matters most here; visitors can pick any other division.
const DEFAULT_DIVISION_ID = stateDivision.get('Illinois')?.id ?? null

const eventsWithDivision = data.events.map(event => {
  const fullName = ABBREVIATION_TO_STATE[event.state] ?? event.state
  const divisionId = stateDivision.get(fullName)?.id ?? null
  return { ...event, divisionId }
})

const divisionSummaries = new Map<number, DivisionSummary>()
for (const state of data.states) {
  const fullName = ABBREVIATION_TO_STATE[state] ?? state
  const division = stateDivision.get(fullName)
  if (!division) continue
  const existing = divisionSummaries.get(division.id)
  if (existing) {
    existing.trackedStates.push(fullName)
  } else {
    divisionSummaries.set(division.id, {
      id: division.id,
      trackedStates: [fullName],
      allStates: division.states,
      count: 0,
    })
  }
}
for (const event of eventsWithDivision) {
  if (event.divisionId !== null && divisionSummaries.has(event.divisionId)) {
    divisionSummaries.get(event.divisionId)!.count++
  }
}
const divisionsForMap = [...divisionSummaries.values()].sort(
  (a, b) => a.id - b.id,
)

function formatDisplayDate(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  })
}

function monthKey(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  })
}

const groups: { month: string; events: typeof eventsWithDivision }[] = []
for (const event of eventsWithDivision) {
  const key = monthKey(event.startDate)
  const existing = groups.find(g => g.month === key)
  if (existing) {
    existing.events.push(event)
  } else {
    groups.push({ month: key, events: [event] })
  }
}

const generatedDisplay = new Date(data.generatedAt).toLocaleDateString(
  'en-US',
  {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  },
)

const keywords = [
  'Great Dane dog shows',
  'AKC dog shows by division',
  'upcoming dog shows near me',
  'Great Dane specialty shows',
  'AKC point schedule division shows',
]
---

<BaseLayout
  title="Upcoming Great Dane Dog Shows by AKC Division | 7Sisters Farm"
  description="Upcoming AKC Great Dane conformation shows nationwide, organized by AKC point-schedule division on an interactive map — pulled from AKC's official event search."
  keywords={keywords}
  canonical="https://7sistersgreatdanes.com/DogShows"
  breadcrumbs={[{ name: 'Upcoming Dog Shows', path: '/DogShows' }]}
>
  <div class="content">
    <div class="post-title">
      <h1>Upcoming Great Dane Dog Shows</h1>
    </div>
    <main class="content-wrapper">
      <section>
        <p>
          AKC-licensed Great Dane conformation shows nationwide, pulled directly
          from{' '}
          <a
            href="https://webapps.akc.org/event-search/#/search"
            target="_blank"
            rel="noopener noreferrer">AKC's official event search</a
          >{' '}— the authoritative listing every superintendent's shows have to
          be registered in.
        </p>
        <details class="ds-intro-details">
          <summary class="ds-details-summary"
            >Where this data comes from</summary
          >
          <p>
            This list covers all 50 states and DC and includes All-Breed, Group,
            and Specialty conformation events for Great Danes, from
            <strong>{data.dateRange.from}</strong> through
            <strong>{data.dateRange.to}</strong>.
          </p>
          <p>
            The map below groups states by AKC point-schedule division — the
            same regions used to figure majors on the
            <a href="/AKCPointSchedule">point schedule page</a>. It defaults to
            Illinois's division; hover any state to see how many shows its
            division has coming up, and click to filter the list to just that
            division.
          </p>
          <p>
            <em
              >Entry closing dates, judges, and even whether a show happens at
              all can change — always confirm directly with the superintendent
              or club before making travel plans. Last pulled from AKC on <strong
                >{generatedDisplay}</strong
              >.</em
            >
          </p>
        </details>
      </section>

      <section aria-label="Filter by division">
        <DogShowsMap
          client:load
          divisions={divisionsForMap}
          initialSelectedDivisionId={DEFAULT_DIVISION_ID}
        />
      </section>

      <section class="ds-root" id="ds-results" aria-label="Upcoming shows">
        {
          groups.length === 0 && (
            <p class="ds-empty">
              No upcoming Great Dane shows found in this window.
            </p>
          )
        }
        {
          groups.map(group => (
            <div class="ds-month-group" data-month-group>
              <h2 class="ds-month-heading">{group.month}</h2>
              {group.events.map(event => (
                <div
                  class="ds-card"
                  data-state={event.state}
                  data-division={event.divisionId ?? ''}
                >
                  <div class="ds-card-top">
                    <span class="ds-card-date">
                      {formatDisplayDate(event.startDate)}
                    </span>
                    <span class="ds-card-state">{event.state}</span>
                  </div>
                  <p class="ds-card-club">
                    {event.clubName}
                    {event.eventNumber && (
                      <span class="ds-card-event-number">
                        {' '}
                        · #{event.eventNumber}
                      </span>
                    )}
                  </p>
                  <p class="ds-card-location">
                    {event.venue ? `${event.venue}, ` : ''}
                    {event.city}, {event.state}
                    {event.postalCode ? ` ${event.postalCode}` : ''}
                  </p>
                  {event.competitionGroups.length > 0 && (
                    <div class="ds-card-groups">
                      {event.competitionGroups.map(g => (
                        <span class="ds-group-badge">{g}</span>
                      ))}
                    </div>
                  )}
                  <p class="ds-card-meta">
                    {event.closingDate && (
                      <>
                        Entries close <strong>{event.closingDate}</strong>
                        {event.superintendent?.name ? ' · ' : ''}
                      </>
                    )}
                    {event.superintendent?.name && (
                      <>
                        {event.superintendent.name}
                        {event.superintendent.email
                          ? ` (${event.superintendent.email})`
                          : ''}
                      </>
                    )}
                  </p>
                </div>
              ))}
            </div>
          ))
        }
        <p class="ds-empty ds-hidden" id="ds-no-matches">
          No shows match the selected division.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  function initDivisionFilter() {
    const cards = document.querySelectorAll<HTMLElement>(
      '.ds-card[data-division]',
    )
    const monthGroups =
      document.querySelectorAll<HTMLElement>('[data-month-group]')
    const noMatches = document.getElementById('ds-no-matches')

    function applyFilter(id: number | null) {
      let anyVisible = false
      cards.forEach(card => {
        const visible = id === null || card.dataset.division === String(id)
        card.classList.toggle('ds-hidden', !visible)
        if (visible) anyVisible = true
      })
      monthGroups.forEach(group => {
        const visibleCards = group.querySelectorAll('.ds-card:not(.ds-hidden)')
        group.classList.toggle('ds-hidden', visibleCards.length === 0)
      })
      noMatches?.classList.toggle('ds-hidden', anyVisible)
    }

    window.addEventListener('ds:division-change', ((
      e: CustomEvent<{ id: number | null }>,
    ) => {
      applyFilter(e.detail.id)
    }) as EventListener)
  }
  initDivisionFilter()
</script>
