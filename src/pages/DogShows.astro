---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/point-schedule.css'
import '../styles/dog-shows.css'
import { loadDogShowsData } from '../lib/dogShowsServer'
import { loadPointScheduleData } from '../lib/pointScheduleServer'
import { stateToDivision, STATE_ABBREVIATIONS } from '../lib/pointSchedule2026'
import { clusterEvents } from '../lib/dogShowClusters'
import DogShowsMap, {
  type DivisionSummary,
} from '../islands/dog-shows/DogShowsMap'

const data = loadDogShowsData()
const scheduleData = loadPointScheduleData()
const stateDivision = stateToDivision(scheduleData)

const ABBREVIATION_TO_STATE: Record<string, string> = Object.fromEntries(
  Object.entries(STATE_ABBREVIATIONS).map(([full, abbr]) => [abbr, full]),
)

// Illinois's division — 7Sisters is Illinois-based, so default the map to
// the region that matters most here; visitors can pick any other division.
const DEFAULT_DIVISION_ID = stateDivision.get('Illinois')?.id ?? null

const todayStr = new Date().toISOString().slice(0, 10)

const eventsWithDivision = data.events.map(event => {
  const fullName = ABBREVIATION_TO_STATE[event.state] ?? event.state
  const divisionId = stateDivision.get(fullName)?.id ?? null
  const isEntryClosed =
    event.closingDate !== null && event.closingDate < todayStr
  return { ...event, divisionId, isEntryClosed }
})

const divisionSummaries = new Map<number, DivisionSummary>()
for (const state of data.states) {
  const fullName = ABBREVIATION_TO_STATE[state] ?? state
  const division = stateDivision.get(fullName)
  if (!division) continue
  const existing = divisionSummaries.get(division.id)
  if (existing) {
    existing.trackedStates.push(fullName)
  } else {
    divisionSummaries.set(division.id, {
      id: division.id,
      trackedStates: [fullName],
      allStates: division.states,
      openCount: 0,
      closedCount: 0,
    })
  }
}
for (const event of eventsWithDivision) {
  if (event.divisionId === null) continue
  const summary = divisionSummaries.get(event.divisionId)
  if (!summary) continue
  if (event.isEntryClosed) summary.closedCount++
  else summary.openCount++
}
const divisionsForMap = [...divisionSummaries.values()].sort(
  (a, b) => a.id - b.id,
)

const clusters = clusterEvents(eventsWithDivision).map(cluster => ({
  ...cluster,
  hasOpenEntry: cluster.events.some(e => !e.isEntryClosed),
}))

function formatDisplayDate(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  })
}

function formatDateRange(start: string, end: string) {
  if (start === end) return formatDisplayDate(start)
  return `${formatDisplayDate(start)} – ${formatDisplayDate(end)}`
}

function monthKey(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  })
}

const groups: { month: string; clusters: typeof clusters }[] = []
for (const cluster of clusters) {
  const key = monthKey(cluster.startDate)
  const existing = groups.find(g => g.month === key)
  if (existing) {
    existing.clusters.push(cluster)
  } else {
    groups.push({ month: key, clusters: [cluster] })
  }
}

const calendarRangeStart = clusters.length ? clusters[0].startDate : todayStr
const calendarRangeEnd = clusters.length
  ? clusters.reduce(
      (max, c) => (c.endDate > max ? c.endDate : max),
      clusters[0].endDate,
    )
  : todayStr

const generatedDisplay = new Date(data.generatedAt).toLocaleDateString(
  'en-US',
  {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  },
)

const keywords = [
  'Great Dane dog shows',
  'AKC dog shows by division',
  'upcoming dog shows near me',
  'Great Dane specialty shows',
  'AKC point schedule division shows',
]
---

<BaseLayout
  title="Upcoming Great Dane Dog Shows by AKC Division | 7Sisters Farm"
  description="Upcoming Great Dane conformation shows nationwide, organized by AKC point-schedule division on an interactive map, groupable by venue cluster and searchable by zip code."
  keywords={keywords}
  canonical="https://7sistersgreatdanes.com/DogShows"
  breadcrumbs={[{ name: 'Upcoming Dog Shows', path: '/DogShows' }]}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <div class="ds-gate" id="ds-gate">
    <div class="ds-gate-box">
      <h1>Personal reference tool</h1>
      <p>
        This page isn't intended for public use — it's a personal, educational
        reference. Enter the access code to continue.
      </p>
      <form id="ds-gate-form">
        <input
          type="password"
          id="ds-gate-code"
          inputmode="numeric"
          autocomplete="off"
          placeholder="Code"
        />
        <button type="submit" class="ps-toggle">Enter</button>
      </form>
      <p id="ds-gate-error" class="ds-gate-error" hidden>
        That code isn't right — try again.
      </p>
      <p class="ds-gate-counter" title={`Data as of ${generatedDisplay}`}>
        {data.dateRange.from} – {data.dateRange.to}
      </p>
    </div>
  </div>

  <div class="content ds-hidden" id="ds-content">
    <div class="post-title">
      <h1>Upcoming Great Dane Dog Shows</h1>
    </div>
    <main class="content-wrapper">
      <section aria-label="Filter by division">
        <DogShowsMap
          client:load
          divisions={divisionsForMap}
          rawEvents={eventsWithDivision.map(e => ({
            divisionId: e.divisionId,
            closingDate: e.closingDate,
          }))}
          initialSelectedDivisionId={DEFAULT_DIVISION_ID}
        />
      </section>

      <section class="ds-zip-search" aria-label="Search by zip code">
        <form id="ds-zip-form">
          <label for="ds-zip-input">Zip code</label>
          <input
            type="text"
            id="ds-zip-input"
            inputmode="numeric"
            pattern="[0-9]{5}"
            maxlength="5"
            placeholder="61820"
            autocomplete="postal-code"
          />
          <label for="ds-radius-select">within</label>
          <select id="ds-radius-select">
            <option value="50">50 miles</option>
            <option value="100" selected>100 miles</option>
            <option value="150">150 miles</option>
            <option value="200">200 miles</option>
            <option value="300">300 miles</option>
            <option value="500">500 miles</option>
          </select>
          <button type="submit" class="ps-toggle">Search</button>
          <button type="button" class="ps-toggle" id="ds-zip-clear" hidden
            >Clear</button
          >
        </form>
        <p id="ds-zip-status" class="ds-zip-status" role="status"></p>
      </section>

      <section aria-label="Show entries-closed toggle" class="ds-closed-toggle">
        <label>
          <input type="checkbox" id="ds-show-closed" />
          Also show shows with entries already closed
        </label>
      </section>

      <section
        class="ds-calendar"
        id="ds-calendar"
        aria-label="Calendar of show dates"
        data-range-start={calendarRangeStart}
        data-range-end={calendarRangeEnd}
      >
        <div class="ds-calendar-header">
          <button
            type="button"
            id="ds-cal-prev"
            class="ps-toggle"
            aria-label="Previous month">‹</button
          >
          <span id="ds-cal-label" class="ds-calendar-label"></span>
          <button
            type="button"
            id="ds-cal-next"
            class="ps-toggle"
            aria-label="Next month">›</button
          >
        </div>
        <div class="ds-calendar-weekdays" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span
            >Thu</span
          ><span>Fri</span><span>Sat</span>
        </div>
        <div id="ds-cal-grid" class="ds-calendar-grid"></div>
      </section>

      <section class="ds-root" id="ds-results" aria-label="Upcoming shows">
        {
          groups.length === 0 && (
            <p class="ds-empty">
              No upcoming Great Dane shows found in this window.
            </p>
          )
        }
        {
          groups.map(group => (
            <div class="ds-month-group" data-month-group>
              <h2 class="ds-month-heading">{group.month}</h2>
              {group.clusters.map(cluster => {
                const isMulti = cluster.events.length > 1
                const subshows = (
                  <div class="ds-cluster-shows">
                    {cluster.events.map(event => (
                      <div
                        class={
                          'ds-subshow' + (isMulti ? '' : ' ds-subshow-solo')
                        }
                        data-closed={event.isEntryClosed ? 'true' : 'false'}
                        data-closing-date={event.closingDate ?? ''}
                      >
                        {isMulti && (
                          <span class="ds-subshow-date">
                            {formatDisplayDate(event.startDate)}
                          </span>
                        )}
                        <p class="ds-card-club">
                          {event.clubName}
                          {event.eventNumber && (
                            <span class="ds-card-event-number">
                              {' '}
                              · #{event.eventNumber}
                            </span>
                          )}
                          <span class="ds-closed-badge">Entries closed</span>
                        </p>
                        {event.competitionGroups.length > 0 && (
                          <div class="ds-card-groups">
                            {event.competitionGroups.map(g => (
                              <span class="ds-group-badge">{g}</span>
                            ))}
                          </div>
                        )}
                        <p class="ds-card-meta">
                          {event.closingDate && (
                            <>
                              Entries close <strong>{event.closingDate}</strong>
                              {event.superintendent?.name ? ' · ' : ''}
                            </>
                          )}
                          {event.superintendent?.name && (
                            <>
                              {event.superintendent.name}
                              {event.superintendent.email
                                ? ` (${event.superintendent.email})`
                                : ''}
                            </>
                          )}
                        </p>
                      </div>
                    ))}
                  </div>
                )
                const header = (
                  <>
                    <div class="ds-card-top">
                      <span class="ds-card-date">
                        {formatDateRange(cluster.startDate, cluster.endDate)}
                      </span>
                      <span class="ds-card-state">{cluster.state}</span>
                    </div>
                    <p class="ds-card-location">
                      {cluster.venue ? `${cluster.venue}, ` : ''}
                      {cluster.city}, {cluster.state}
                      {cluster.postalCode ? ` ${cluster.postalCode}` : ''}
                      <span class="ds-card-distance" hidden />
                    </p>
                  </>
                )
                return (
                  <div
                    class="ds-card"
                    data-state={cluster.state}
                    data-division={cluster.divisionId ?? ''}
                    data-has-open={cluster.hasOpenEntry ? 'true' : 'false'}
                    data-lat={cluster.coordinates?.lat ?? ''}
                    data-lon={cluster.coordinates?.lon ?? ''}
                    data-start-date={cluster.startDate}
                    data-end-date={cluster.endDate}
                  >
                    {isMulti ? (
                      <details class="ds-cluster-details">
                        <summary class="ds-cluster-summary">
                          {header}
                          <p class="ds-cluster-badge">
                            {cluster.events.length} shows in this cluster
                          </p>
                        </summary>
                        {subshows}
                      </details>
                    ) : (
                      <>
                        {header}
                        {subshows}
                      </>
                    )}
                  </div>
                )
              })}
            </div>
          ))
        }
        <p class="ds-empty ds-hidden" id="ds-no-matches">
          No shows match the current filters.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  // Soft gate only — this is a static site with no backend, so the code and
  // the gated markup are both visible to anyone who reads the page source.
  // It's meant to keep casual/incidental visitors out, not provide real
  // access control.
  function initGate() {
    const CODE = '1887'
    const gate = document.getElementById('ds-gate')
    const content = document.getElementById('ds-content')
    const form = document.getElementById(
      'ds-gate-form',
    ) as HTMLFormElement | null
    const input = document.getElementById(
      'ds-gate-code',
    ) as HTMLInputElement | null
    const error = document.getElementById('ds-gate-error')

    function unlock() {
      gate?.setAttribute('hidden', '')
      content?.classList.remove('ds-hidden')
    }

    // Intentionally not remembered across visits (no localStorage/cookie) —
    // the code is asked for every time the page loads.
    form?.addEventListener('submit', e => {
      e.preventDefault()
      if (input?.value.trim() === CODE) {
        unlock()
      } else {
        error?.removeAttribute('hidden')
        if (input) input.value = ''
        input?.focus()
      }
    })
  }
  initGate()
</script>

<script>
  interface ZipCoordinates {
    [zip: string]: [number, number]
  }

  function haversineMiles(
    lat1: number,
    lon1: number,
    lat2: number,
    lon2: number,
  ): number {
    const R = 3958.8
    const toRad = (d: number) => (d * Math.PI) / 180
    const dLat = toRad(lat2 - lat1)
    const dLon = toRad(lon2 - lon1)
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
  }

  // The data can be days or weeks old (refreshed manually now, not on a
  // schedule) — recompute every show's open/closed status against the
  // visitor's actual current date on every page load, rather than trusting
  // whatever was true when the data was last pulled. Corrects data-closed
  // (badges + grayscale styling react to this via CSS) and data-has-open.
  function recomputeFreshness() {
    const todayStr = new Date().toISOString().slice(0, 10)

    document.querySelectorAll<HTMLElement>('.ds-card').forEach(card => {
      let anyOpen = false
      card
        .querySelectorAll<HTMLElement>('.ds-subshow[data-closing-date]')
        .forEach(sub => {
          const closingDate = sub.dataset.closingDate ?? ''
          const isClosed = closingDate !== '' && closingDate < todayStr
          sub.dataset.closed = isClosed ? 'true' : 'false'
          if (!isClosed) anyOpen = true
        })
      card.dataset.hasOpen = anyOpen ? 'true' : 'false'
    })
  }

  function initFilters() {
    recomputeFreshness()

    const cards = document.querySelectorAll<HTMLElement>(
      '.ds-card[data-division]',
    )
    const monthGroups =
      document.querySelectorAll<HTMLElement>('[data-month-group]')
    const noMatches = document.getElementById('ds-no-matches')
    const showClosedCheckbox = document.getElementById(
      'ds-show-closed',
    ) as HTMLInputElement | null
    const zipForm = document.getElementById(
      'ds-zip-form',
    ) as HTMLFormElement | null
    const zipInput = document.getElementById(
      'ds-zip-input',
    ) as HTMLInputElement | null
    const radiusSelect = document.getElementById(
      'ds-radius-select',
    ) as HTMLSelectElement | null
    const zipClearBtn = document.getElementById('ds-zip-clear')
    const zipStatus = document.getElementById('ds-zip-status')

    let selectedDivisionId: number | null = null
    let distanceFilter: { lat: number; lon: number; radius: number } | null =
      null
    let zipCoordinates: ZipCoordinates | null = null

    function applyFilters() {
      const showClosed = showClosedCheckbox?.checked ?? false
      let anyVisible = false

      cards.forEach(card => {
        const divisionOk =
          selectedDivisionId === null ||
          card.dataset.division === String(selectedDivisionId)

        let distanceOk = true
        const distanceEl = card.querySelector<HTMLElement>('.ds-card-distance')
        if (distanceFilter) {
          const lat = Number.parseFloat(card.dataset.lat ?? '')
          const lon = Number.parseFloat(card.dataset.lon ?? '')
          if (Number.isNaN(lat) || Number.isNaN(lon)) {
            distanceOk = false
          } else {
            const miles = haversineMiles(
              distanceFilter.lat,
              distanceFilter.lon,
              lat,
              lon,
            )
            distanceOk = miles <= distanceFilter.radius
            if (distanceOk && distanceEl) {
              distanceEl.textContent = ` · ${Math.round(miles)} mi away`
              distanceEl.hidden = false
            }
          }
        } else if (distanceEl) {
          distanceEl.hidden = true
        }

        const subshows = card.querySelectorAll<HTMLElement>('.ds-subshow')
        let anyOpenSubshow = false
        subshows.forEach(sub => {
          const closed = sub.dataset.closed === 'true'
          const subVisible = showClosed || !closed
          sub.classList.toggle('ds-hidden', !subVisible)
          if (!closed) anyOpenSubshow = true
        })

        const closedOk = showClosed || anyOpenSubshow
        const visible = divisionOk && distanceOk && closedOk
        card.classList.toggle('ds-hidden', !visible)
        if (visible) anyVisible = true
      })

      monthGroups.forEach(group => {
        const visibleCards = group.querySelectorAll('.ds-card:not(.ds-hidden)')
        group.classList.toggle('ds-hidden', visibleCards.length === 0)
      })
      noMatches?.classList.toggle('ds-hidden', anyVisible)
      window.dispatchEvent(new CustomEvent('ds:filters-applied'))
    }

    window.addEventListener('ds:division-change', ((
      e: CustomEvent<{ id: number | null }>,
    ) => {
      selectedDivisionId = e.detail.id
      applyFilters()
    }) as EventListener)

    showClosedCheckbox?.addEventListener('change', applyFilters)

    zipForm?.addEventListener('submit', async e => {
      e.preventDefault()
      const zip = zipInput?.value.trim() ?? ''
      const radius = Number.parseInt(radiusSelect?.value ?? '100', 10)
      if (!/^\d{5}$/.test(zip)) {
        if (zipStatus) zipStatus.textContent = 'Enter a 5-digit zip code.'
        return
      }
      if (zipStatus) zipStatus.textContent = 'Searching…'
      if (!zipCoordinates) {
        try {
          const res = await fetch('/data/zip-coordinates.json')
          zipCoordinates = (await res.json()) as ZipCoordinates
        } catch {
          if (zipStatus)
            zipStatus.textContent = "Couldn't load zip code data. Try again."
          return
        }
      }
      const coords = zipCoordinates[zip]
      if (!coords) {
        if (zipStatus) zipStatus.textContent = `Zip code ${zip} not found.`
        distanceFilter = null
        applyFilters()
        return
      }
      distanceFilter = { lat: coords[0], lon: coords[1], radius }
      if (zipStatus)
        zipStatus.textContent = `Showing shows within ${radius} miles of ${zip}.`
      zipClearBtn?.removeAttribute('hidden')
      applyFilters()
      document
        .getElementById('ds-results')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })

    zipClearBtn?.addEventListener('click', () => {
      distanceFilter = null
      if (zipInput) zipInput.value = ''
      if (zipStatus) zipStatus.textContent = ''
      zipClearBtn.setAttribute('hidden', '')
      applyFilters()
    })

    applyFilters()
  }
  initFilters()
</script>

<script>
  // Highlights days with at least one currently-visible (i.e. passing the
  // division/distance/closed filters) show. Re-renders on the same
  // ds:filters-applied event the filter script fires, so it always reflects
  // whatever's currently selected above it.
  function initCalendar() {
    const section = document.getElementById('ds-calendar')
    const grid = document.getElementById('ds-cal-grid')
    const label = document.getElementById('ds-cal-label')
    const prevBtn = document.getElementById(
      'ds-cal-prev',
    ) as HTMLButtonElement | null
    const nextBtn = document.getElementById(
      'ds-cal-next',
    ) as HTMLButtonElement | null
    if (!section || !grid || !label || !prevBtn || !nextBtn) return

    const rangeStart = section.dataset.rangeStart ?? ''
    const rangeEnd = section.dataset.rangeEnd ?? ''
    if (!rangeStart || !rangeEnd) return

    function monthStart(iso: string): Date {
      const d = new Date(`${iso}T00:00:00Z`)
      return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1))
    }

    const minMonth = monthStart(rangeStart)
    const maxMonth = monthStart(rangeEnd)
    const todayIso = new Date().toISOString().slice(0, 10)
    let current =
      todayIso >= rangeStart && todayIso <= rangeEnd
        ? monthStart(todayIso)
        : minMonth

    function render() {
      label!.textContent = current.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      })
      prevBtn!.disabled = current.getTime() <= minMonth.getTime()
      nextBtn!.disabled = current.getTime() >= maxMonth.getTime()

      const ranges: { start: string; end: string; state: string }[] = []
      document
        .querySelectorAll<HTMLElement>('.ds-card:not(.ds-hidden)')
        .forEach(card => {
          const start = card.dataset.startDate
          const end = card.dataset.endDate
          if (start && end) {
            ranges.push({ start, end, state: card.dataset.state ?? '' })
          }
        })

      const year = current.getUTCFullYear()
      const month = current.getUTCMonth()
      const firstWeekday = new Date(Date.UTC(year, month, 1)).getUTCDay()
      const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate()

      grid!.innerHTML = ''
      for (let i = 0; i < firstWeekday; i++) {
        const empty = document.createElement('span')
        empty.className = 'ds-cal-cell ds-cal-cell-empty'
        grid!.appendChild(empty)
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const iso = `${year}-${String(month + 1).padStart(2, '0')}-${String(
          day,
        ).padStart(2, '0')}`
        const matches = ranges.filter(r => iso >= r.start && iso <= r.end)
        const cell = document.createElement('button')
        cell.type = 'button'
        cell.className =
          'ds-cal-cell' + (matches.length > 0 ? ' ds-cal-has-show' : '')
        if (iso === todayIso) cell.classList.add('ds-cal-today')
        cell.textContent = String(day)
        if (matches.length > 0) {
          const states = [...new Set(matches.map(m => m.state))].join(', ')
          cell.title = `${matches.length} show${matches.length === 1 ? '' : 's'} (${states})`
          cell.addEventListener('click', () => {
            const target = [
              ...document.querySelectorAll<HTMLElement>(
                '.ds-card:not(.ds-hidden)',
              ),
            ].find(card => {
              const start = card.dataset.startDate
              const end = card.dataset.endDate
              return start && end && iso >= start && iso <= end
            })
            target?.scrollIntoView({ behavior: 'smooth', block: 'center' })
            target?.classList.add('ds-card-flash')
            setTimeout(() => target?.classList.remove('ds-card-flash'), 1500)
          })
        } else {
          cell.disabled = true
        }
        grid!.appendChild(cell)
      }
    }

    prevBtn.addEventListener('click', () => {
      current = new Date(
        Date.UTC(current.getUTCFullYear(), current.getUTCMonth() - 1, 1),
      )
      render()
    })
    nextBtn.addEventListener('click', () => {
      current = new Date(
        Date.UTC(current.getUTCFullYear(), current.getUTCMonth() + 1, 1),
      )
      render()
    })

    window.addEventListener('ds:filters-applied', render)
    render()
  }
  initCalendar()
</script>
