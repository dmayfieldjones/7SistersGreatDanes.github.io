---
import BaseLayout from '../../layouts/BaseLayout.astro'

const project = [
  {
    n: '1',
    href: '/breed-map.html',
    img: '/img/private/breed-map.jpg',
    title: 'The Map',
    role: 'The picture',
    desc: 'A guided tour of 7,000+ Great Danes by pedigree. How related are they, and how few dogs could we DNA-test to learn about most of the breed?',
  },
  {
    n: '2',
    href: '/breeding-history.html',
    img: '/img/private/breeding-history.jpg',
    title: 'The History',
    role: 'How we got here',
    desc: 'Six steps through 140 years of records: two wars, a new continent, inbreeding peaks and new color rules.',
  },
  {
    n: '3',
    href: '/private/kinship-study',
    img: '/img/private/kinship-study.jpg',
    title: 'The Evidence',
    role: 'The details behind 1 and 2',
    desc: 'The Kinship Study: methods, numbers and data quality, for anyone who wants to check the work.',
  },
  {
    n: '4',
    href: '/sequencing-proposal.html',
    img: '/img/private/sequencing-proposal.jpg',
    title: 'The Plan',
    role: 'What we would do about it',
    desc: 'The sequencing proposal: which dogs to sequence to preserve the breed’s genetic diversity, with a pilot genome. Working draft.',
  },
]
const tools = [
  {
    href: '/ezra-mia-pedigree.html',
    img: '/img/private/ezra-mia.jpg',
    title: 'Ezra × Mia: Pedigree Explorer',
    desc: 'Exploratory 10-generation pedigree analysis, not an announced litter.',
  },
  {
    href: '/DogShows',
    img: '/img/private/dogshows.jpg',
    title: 'Dog Show Finder',
    desc: 'Upcoming Great Dane shows by AKC division, searchable by zip code.',
  },
]
---

<BaseLayout
  title="Private | 7Sisters Farm"
  canonical="https://7sistersgreatdanes.com/private"
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <div class="pv-gate" id="pv-gate">
    <div class="pv-gate-box">
      <h1>Personal reference index</h1>
      <p>
        This page isn't intended for public use — it's a personal index of
        in-progress or non-public tools. Enter the access code to continue.
      </p>
      <form id="pv-gate-form">
        <input
          type="password"
          id="pv-gate-code"
          inputmode="numeric"
          autocomplete="off"
          placeholder="Code"
        />
        <button type="submit">Enter</button>
      </form>
      <p id="pv-gate-error" class="pv-gate-error" hidden>
        That code isn't right — try again.
      </p>
    </div>
  </div>

  <div class="pv-content pv-hidden" id="pv-content">
    <div class="pv-wrap">
      <h1>Great Dane Population Genomics</h1>
      <p class="pv-intro">
        How related are today's Great Danes, how did the breed come to be this
        way, and which dogs would teach us the most if we sequenced them? A
        working project that starts from pedigree records and aims at the
        genome. The four pages tell it in order. Start with the map.
      </p>
      <ol class="pv-links pv-steps">
        {
          project.map(link => (
            <li>
              <a class="pv-card" href={link.href}>
                <img class="pv-thumb" src={link.img} alt="" loading="lazy" />
                <span class="pv-card-title">
                  <span class="pv-num">{link.n}</span> {link.title}
                  <span class="pv-role">{link.role}</span>
                </span>
                <span class="pv-card-desc">{link.desc}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <h2 class="pv-sub">Other tools</h2>
      <div class="pv-links">
        {
          tools.map(link => (
            <a class="pv-card" href={link.href}>
              <img class="pv-thumb" src={link.img} alt="" loading="lazy" />
              <span class="pv-card-title">{link.title}</span>
              <span class="pv-card-desc">{link.desc}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .pv-gate {
    display: flex;
    justify-content: center;
    padding: 3rem 1.25rem;
  }
  .pv-gate[hidden] {
    display: none;
  }
  .pv-gate-box {
    max-width: 22rem;
    text-align: center;
    background: #f8f8f8;
    border: 1px solid rgba(0, 0, 0, 0.35);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
  }
  .pv-gate-box h1 {
    font-size: 1.3rem;
    margin: 0 0 0.6rem;
  }
  .pv-gate-box p {
    color: #52514e;
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .pv-gate-box form {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .pv-gate-box input[type='password'] {
    width: 7rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    border: 2px solid rgba(0, 0, 0, 0.35);
    background: #ffffff;
    color: #0b0b0b;
    font-size: 0.9rem;
    text-align: center;
  }
  .pv-gate-box button {
    font-weight: 600;
    background: #bf141c;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }
  .pv-gate-error {
    color: #bf141c;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0.75rem 0 0;
  }

  .pv-hidden {
    display: none !important;
  }
  .pv-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }
  .pv-wrap h1 {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .pv-links {
    display: grid;
    gap: 1rem;
  }
  .pv-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
    background: #f8f8f8;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .pv-card:hover {
    border-color: #bf141c;
    background: #fdf2f2;
  }
  .pv-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    margin-bottom: 0.6rem;
  }
  .pv-intro {
    text-align: center;
    color: #52514e;
    margin: -0.75rem auto 1.75rem;
    max-width: 34rem;
  }
  .pv-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pv-num {
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    line-height: 1.5em;
    text-align: center;
    border-radius: 50%;
    background: #bf141c;
    color: #fff;
    font-size: 0.85em;
  }
  .pv-role {
    display: block;
    font-weight: 400;
    font-size: 0.82rem;
    color: #52514e;
  }
  .pv-sub {
    font-size: 1.1rem;
    margin: 2rem 0 0.75rem;
    text-align: center;
  }
  .pv-card-title {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .pv-card-desc {
    color: #52514e;
    font-size: 0.9rem;
  }
</style>

<script>
  // Soft gate only — this is a static site with no backend, so the code and
  // the gated markup are both visible to anyone who reads the page source.
  // It's meant to keep casual/incidental visitors out, not provide real
  // access control.
  function initGate() {
    const CODE = '1887'
    const gate = document.getElementById('pv-gate')
    const content = document.getElementById('pv-content')
    const form = document.getElementById(
      'pv-gate-form',
    ) as HTMLFormElement | null
    const input = document.getElementById(
      'pv-gate-code',
    ) as HTMLInputElement | null
    const error = document.getElementById('pv-gate-error')

    function unlock() {
      gate?.setAttribute('hidden', '')
      content?.classList.remove('pv-hidden')
    }

    // Back/forward navigation can restore this page from memory already
    // unlocked; lock it again so the code is asked for on every visit.
    window.addEventListener('pageshow', e => {
      if (!e.persisted) return
      content?.classList.add('pv-hidden')
      gate?.removeAttribute('hidden')
      error?.setAttribute('hidden', '')
      if (input) input.value = ''
    })

    // The hub itself asks for the code on every load. A correct code is
    // remembered for this browser tab (sessionStorage) only so the private
    // pages linked from here, which carry their own gate (/private-gate.js),
    // don't ask a second time.
    function remember(key: string) {
      try {
        sessionStorage.setItem(key, '1')
      } catch {
        // storage blocked: each page will just ask for the code itself
      }
    }
    form?.addEventListener('submit', e => {
      e.preventDefault()
      const entered = input?.value.trim()
      if (entered === CODE) {
        remember('pv-ok-all')
        unlock()
      } else {
        error?.removeAttribute('hidden')
        if (input) input.value = ''
        input?.focus()
      }
    })
  }
  initGate()
</script>
