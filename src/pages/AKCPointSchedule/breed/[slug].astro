---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PointScheduleMap from '../../../islands/point-schedule/PointScheduleMap'
import PointScheduleTable from '../../../components/PointScheduleTable.astro'
import '../../../styles/point-schedule.css'
import { pointsForBreed, slugifyBreed, ALL_OTHER_BREEDS, breedLabel } from '../../../lib/pointSchedule2026'
import { loadPointScheduleData } from '../../../lib/pointScheduleServer'

export function getStaticPaths() {
  const scheduleData = loadPointScheduleData()
  return scheduleData.breeds.map(breed => ({
    params: { slug: slugifyBreed(breed) },
    props: { breed },
  }))
}

const { breed } = Astro.props as { breed: string }
const scheduleData = loadPointScheduleData()
const EFFECTIVE_DATE = scheduleData.effectiveDate
const slug = slugifyBreed(breed)
const isCatchAll = breed === ALL_OTHER_BREEDS

const BREED_DIVISIONS = scheduleData.divisions.map(division => ({
  id: division.id,
  states: division.states,
  points: pointsForBreed(division, breed)!,
}))

const displayName = breedLabel(breed)

const keywords = [
  'AKC point schedule',
  `${displayName} point schedule`,
  '2026 point schedule',
  'dog show points needed for major',
  'AKC conformation divisions',
  `${displayName} majors`,
]
---

<BaseLayout
  title={`2026 AKC ${displayName} Point Schedule by Division | 7Sisters Farm`}
  description={`Interactive map of the AKC's 2026 point schedule for ${displayName}: how many dogs and bitches are needed for a major in every division, effective ${EFFECTIVE_DATE}.`}
  keywords={keywords}
  canonical={`https://7sistersgreatdanes.com/AKCPointSchedule/breed/${slug}`}
  breadcrumbs={[
    { name: 'AKC Point Schedule', path: '/AKCPointSchedule' },
    { name: displayName, path: `/AKCPointSchedule/breed/${slug}` },
  ]}
>
  <div class="content">
    <div class="post-title">
      <h1>2026 AKC {displayName} Point Schedule</h1>
    </div>
    <main class="content-wrapper">
      <section>
        {
          isCatchAll ? (
            <p>
              Tap a state below to see what it takes for a major there
              under this AKC catch-all.
            </p>
          ) : (
            <p>Tap a state below to see what it takes for a {breed} major there.</p>
          )
        }
        <details class="ps-intro-details">
          <summary class="ps-details-summary">What am I looking at?</summary>
          {
            isCatchAll ? (
              <p>
                "All other breeds and varieties" is the AKC's catch-all
                division-points bucket for breeds and varieties that aren't
                individually broken out in the point schedule. This covers
                the schedule effective <strong>{EFFECTIVE_DATE}</strong>.
                Hover or focus a state to see the minimum dogs and bitches
                needed for a 3-point major there; click or tap it for that
                division's full 1-through-5-point breakdown (3, 4, and
                5-point wins are majors).
              </p>
            ) : (
              <p>
                The AKC redraws how many {breed} you need to beat for a
                major every year, division by division. This covers the
                schedule effective <strong>{EFFECTIVE_DATE}</strong>. Hover
                or focus a state to see the minimum dogs and bitches needed
                for a 3-point major there; click or tap it for that
                division's full 1-through-5-point breakdown (3, 4, and
                5-point wins are majors).
              </p>
            )
          }
          <p>
            Looking for a different breed? The breed field above the map
            searches all {scheduleData.breeds.length} AKC breeds and
            varieties, or see the <a href="/AKCPointSchedule#breed-index"
              >full breed index</a
            >.
          </p>
          <p>
            <em
              >AKC point schedules can be revised — always confirm the
              current numbers at <a
                href={scheduleData.sourceUrl}
                target="_blank"
                rel="noopener noreferrer">akc.org</a
              > before entering a show. Last pulled from the AKC's
              all-divisions schedule on <strong
                >{scheduleData.sourceCheckedDate}</strong
              >.</em
            >
          </p>
        </details>
      </section>

      <section aria-label="Interactive point schedule map">
        <PointScheduleMap
          client:only="react"
          initialBreed={breed}
          breedIndexHref="/AKCPointSchedule#breed-index"
        />
      </section>

      <section style="margin-top: 2.5rem">
        <h2 class="section-title">Full {displayName} schedule, all divisions</h2>
        <PointScheduleTable breed={displayName} divisions={BREED_DIVISIONS} />
      </section>
    </main>
  </div>
</BaseLayout>
