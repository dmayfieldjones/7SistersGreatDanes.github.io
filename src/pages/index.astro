---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TIKTOK_EMBED_URL, SITE_TIKTOK_URL } from '../lib/site'

const HERO_VIDEO_SRC = '/video/hero-bg.mp4'
const HERO_VIDEO_POSTER = '/img/hero-bg-poster.jpg'
const HERO_MOBILE_PHOTO = '/img/hero-options/hero-option-1m12s.jpg'

const keywords = [
  'Illinois Great Dane breeders',
  'Illinois dogs',
  'Illinois breeders',
  'Great Dane breeders Illinois',
  'Central Illinois Great Danes',
  'AKC Great Danes Illinois',
  'Illinois dog breeders',
  'Great Dane puppies Illinois',
  '7Sisters Farm',
  'Champaign Illinois breeders',
  'Urbana Illinois dogs',
  'Illinois Great Dane kennel',
]
---

<BaseLayout
  title="Illinois Great Dane Breeders | 7Sisters Farm - Central Illinois"
  description="Premier Illinois Great Dane breeders at 7Sisters Farm in Central Illinois. AKC registered Great Danes, health tested, family raised. Serving Illinois and surrounding states."
  keywords={keywords}
  image="https://7sistersgreatdanes.com/img/wedding.png"
  canonical="https://7sistersgreatdanes.com"
>
  <div
    class="homepage-container"
    style="overflow-y: visible; touch-action: pan-y"
  >
    <section class="video-hero-section">
      <div class="video-background" id="video-background">
        <div class="video-iframe video-iframe-placeholder" aria-hidden="true">
        </div>
        <div class="video-overlay"></div>
      </div>
      <div
        class="scroll-indicator"
        id="scroll-indicator"
        role="button"
        aria-label="Scroll down for more about 7Sisters"
        tabindex="0"
      >
        <div class="scroll-arrow"></div>
        <span class="scroll-text">More below</span>
      </div>
    </section>

    <section class="content-section home-below-hero" id="home-below-hero">
      <div class="content-overlay text-center home-intro-wrap">
        <img
          src="/img/Colorlogo_nobackground.png"
          alt="7Sisters Farm"
          width="220"
          height="auto"
          class="hero-logo home-intro-logo"
          loading="lazy"
        />

        <p class="home-intro-text">
          We're <strong>Dustin and Karen Mayfield-Jones</strong>, breeders of
          Champion Great Danes at <span class="text-red-600 font-semibold"
            >7</span
          >Sisters Farm in Central Illinois (Champaign–Urbana area). Our dogs
          are AKC-registered, live with us, receive health testing, and are
          raised with a focus on sound structure and temperament. Exploring a
          litter or a breeder? Start below; everything else—our farm, articles,
          genome tools—is in the menu.
        </p>

        <div
          class="home-cta-list"
          role="navigation"
          aria-label="Primary actions"
        >
          <a href="/7Sisters" class="home-cta home-cta-primary">Meet our dogs</a
          >
          <a href="/BreedingPhilosophy" class="home-cta">
            Our breeding philosophy
          </a>
          <a href="/contact" class="home-cta">Contact us</a>
        </div>
      </div>

      <section
        class="site-tiktok-section"
        aria-label="7Sisters Great Danes on TikTok"
      >
        <div class="site-tiktok-embed-wrap" id="tiktok-embed-wrap">
          <button
            type="button"
            class="site-tiktok-embed site-tiktok-placeholder"
            id="tiktok-load-button"
            aria-label="Load our TikTok videos"
          >
            <svg
              class="tiktok-placeholder-icon"
              viewBox="0 0 24 24"
              width="40"
              height="40"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M16.6 5.82c-1-.86-1.6-2.13-1.6-3.55h-3.02v13.9c0 1.66-1.35 3.01-3.02 3.01a3.01 3.01 0 0 1-3.02-3.01 3.01 3.01 0 0 1 3.02-3.02c.31 0 .61.05.9.13V9.94a6.03 6.03 0 0 0-.9-.07A6.03 6.03 0 0 0 3.94 16a6.03 6.03 0 0 0 6.02 6.02A6.03 6.03 0 0 0 16 16V8.36a7.9 7.9 0 0 0 4.62 1.48V6.82c-1.4 0-2.7-.44-3.98-1z"
              ></path>
            </svg>
            <span class="tiktok-placeholder-text"
              >View our latest videos on TikTok</span
            >
          </button>
        </div>
        <a href={SITE_TIKTOK_URL} class="site-tiktok-profile-link"
          >@7sistersgreatdanes on TikTok</a
        >
      </section>
    </section>

    <p class="home-quiet-link">
      <a href="/DogShows" rel="nofollow" title="Personal reference tool">•</a>
    </p>
  </div>
</BaseLayout>

<script is:inline define:vars={{ SITE_TIKTOK_EMBED_URL }}>
  ;(function () {
    const wrap = document.getElementById('tiktok-embed-wrap')
    const button = document.getElementById('tiktok-load-button')

    button?.addEventListener('click', function () {
      const iframe = document.createElement('iframe')
      iframe.src = SITE_TIKTOK_EMBED_URL
      iframe.className = 'site-tiktok-embed'
      iframe.title = '7Sisters Great Danes on TikTok'
      iframe.setAttribute('allow', 'encrypted-media; fullscreen')
      wrap?.replaceChild(iframe, button)
    })
  })()
</script>

<script
  is:inline
  define:vars={{ HERO_VIDEO_SRC, HERO_VIDEO_POSTER, HERO_MOBILE_PHOTO }}
>
  ;(function () {
    const isMobile = window.matchMedia(
      '(max-width: 768px), (pointer: coarse)',
    ).matches
    const background = document.getElementById('video-background')
    const heroSection = document.querySelector('.video-hero-section')
    let current = background?.querySelector('.video-iframe-placeholder')

    function swapIn(el) {
      if (background && current) {
        background.replaceChild(el, current)
        current = el
      }
    }

    const video = document.createElement('video')
    video.src = HERO_VIDEO_SRC
    video.poster = HERO_VIDEO_POSTER
    video.className = 'video-iframe video-native'
    video.autoplay = true
    video.muted = true
    video.loop = true
    video.playsInline = true
    video.setAttribute('aria-hidden', 'true')
    swapIn(video)

    // iOS Safari is unreliable about honoring the declarative `autoplay`
    // property alone on a <video> created and inserted via JS after initial
    // page load — explicitly calling play() is the more robust pattern
    // there. Retry once metadata is available in case the first attempt
    // fires before the browser has enough data to start.
    function tryPlay() {
      const p = video.play()
      if (p && typeof p.catch === 'function') p.catch(() => {})
    }
    tryPlay()
    video.addEventListener('loadedmetadata', tryPlay, { once: true })

    // The video and its .video-background container both have
    // pointer-events: none (so taps pass through for scrolling), but some
    // mobile browsers render their own "tap to play" affordance over a
    // video that didn't autoplay — with pointer-events: none underneath,
    // that tap lands on nothing, so it visibly does nothing. .video-hero-
    // section is the ancestor that actually receives pointer events
    // (pointer-events: auto, for scroll handling) — a real click/touch
    // anywhere in it is always a valid user gesture browsers will honor
    // for play(), so catch it there and retry.
    heroSection?.addEventListener('click', tryPlay)
    heroSection?.addEventListener('touchend', tryPlay)

    // Mobile autoplay is still unreliable in practice even with the above
    // (data-saver modes, low-power mode, flaky cellular buffering) — rather
    // than leaving mobile visitors stuck on a frozen poster indefinitely,
    // fall back to a guaranteed-good static photo if the video genuinely
    // hasn't started playing after a while. Note: video.paused goes false
    // the instant play() is called, regardless of whether any frame has
    // actually rendered — the 'playing' event is the real signal that
    // decoded video is on screen. The video's own poster is already
    // visible during this wait (not a black box), so there's no rush —
    // give a real cellular connection a fair chance to buffer 44MB before
    // giving up on it.
    let hasStartedPlaying = false
    video.addEventListener('playing', function () {
      hasStartedPlaying = true
    })
    if (isMobile) {
      setTimeout(function () {
        if (!hasStartedPlaying && video.isConnected) {
          const img = document.createElement('img')
          img.src = HERO_MOBILE_PHOTO
          img.alt = ''
          img.className = 'video-iframe hero-mobile-photo'
          img.decoding = 'async'
          img.setAttribute('aria-hidden', 'true')
          swapIn(img)
        }
      }, 8000)
    }

    // Scroll indicator: click/keyboard scrolls past the hero; hide once hero leaves view
    const indicator = document.getElementById('scroll-indicator')
    function scrollDown() {
      const y = heroSection
        ? heroSection.getBoundingClientRect().height + window.scrollY
        : window.innerHeight
      window.scrollTo({ top: y, behavior: 'smooth' })
    }
    indicator?.addEventListener('click', function () {
      scrollDown()
    })
    indicator?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        scrollDown()
      }
    })
    if (heroSection && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        function (entries) {
          indicator?.classList.toggle(
            'scroll-indicator--hero-out',
            !entries[0].isIntersecting,
          )
        },
        { threshold: 0, rootMargin: '0px 0px -32px 0px' },
      ).observe(heroSection)
    }

    // Reveal below-hero content when it scrolls into view
    const below = document.getElementById('home-below-hero')
    if (below && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              below.classList.add('content-visible')
              io.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
      )
      io.observe(below)
    } else if (below) {
      below.classList.add('content-visible')
    }
  })()
</script>
