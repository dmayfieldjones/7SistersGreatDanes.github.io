---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/litter.css'
import { SITE_TIKTOK_URL } from '../lib/site'

const puppies = [
  { collar: 'Black', sex: 'Boy', color: '#111111' },
  { collar: 'Red', sex: 'Boy', color: '#d11f26' },
  { collar: 'Blue', sex: 'Boy', color: '#1f5fd1' },
  { collar: 'Pink', sex: 'Girl', color: '#f06fa8' },
  { collar: 'Purple', sex: 'Girl', color: '#7b3fb5' },
]

const keywords = [
  'Ezra Mia Great Dane litter',
  'Great Dane Futurity nominated litter',
  '7Sisters Farm litter',
  'Great Dane puppies Illinois',
  'Central Illinois Great Dane puppies',
  'health tested Great Dane puppies',
  'upcoming Great Dane litter',
]
---

<BaseLayout
  title="Ezra × Mia Litter | 7Sisters Farm — Futurity Nominated Great Dane Litter"
  description="Ezra × Mia litter at 7Sisters Farm: a 2027 Futurity nominated Great Dane litter born October 17th, 2026: three boys and two girls. CHIC-certified, health-tested parents. Inquiries welcome. Central Illinois Great Dane breeders."
  keywords={keywords}
  image="https://7sistersgreatdanes.com/img/EzraxMia.jpg"
  canonical="https://7sistersgreatdanes.com/EzraxMia"
  breadcrumbs={[
    { name: 'Puppies & Litters', path: '/Litters' },
    { name: 'Ezra × Mia Litter', path: '/EzraxMia' },
  ]}
>
  <div class="content">
    <div class="post-title">
      <h1>
        Ezra x Mia Litter at <span style="color: #bf141c">7</span>Sisters Farm
      </h1>
    </div>
    <main class="content-wrapper">
      <section class="hero-section">
        <img
          src="/img/Colorlogo_nobackground.png"
          alt="7Sisters Farm Logo"
          width="300"
          height="auto"
          class="hero-logo"
          loading="lazy"
        />
      </section>
      <section class="advertisement-section">
        <img
          src="/img/EzraxMia.jpg"
          alt="Ezra X Mia litter advertisement: 2027 Futurity nominated litter due October 16th"
          class="ad-image"
          width="1999"
          height="1500"
          loading="eager"
        />
        <p class="ad-caption">
          Follow along on <a
            href={SITE_TIKTOK_URL}
            target="_blank"
            rel="noopener noreferrer">TikTok</a
          >, or <a href="/contact">contact us</a> to ask
          about a puppy.
        </p>
      </section>
      <section class="litter-info-section">
        <div class="litter-details">
          <h2 class="section-title">Litter Information</h2>
          <div class="info-grid">
            <div class="info-item">
              <span class="label">Status:</span>
              <span class="value">Born — inquiries welcome</span>
            </div>
            <div class="info-item">
              <span class="label">Puppies:</span>
              <span class="value">Five total — three boys, two girls</span>
            </div>
            <div class="info-item">
              <span class="label">Whelped:</span>
              <span class="value">October 17, 2026</span>
            </div>
            <div class="info-item">
              <span class="label">Futurity:</span>
              <span class="value">Nominated for the 2027 GDCA Futurity</span>
            </div>
            <div class="info-item">
              <span class="label">Breeders:</span>
              <span class="value"
                >Dustin Mayfield-Jones, Karen Mayfield-Jones, Francisco
                Camacho, Karen Martin</span
              >
            </div>
          </div>
        </div>
        <div class="parents-info">
          <div class="parent-card">
            <h3 class="parent-title">Sire</h3>
            <p class="parent-name">
              BISS GCH Sonya Danes N Krisda Our Peace And Harmony Fontana{' '}
              <span class="call-name">"Ezra"</span>
            </p>
            <p class="registration">CHIC #218946</p>
            <p class="registration">
              <a
                href="https://ofa.org/advanced-search/?regnum=WS81479201"
                target="_blank"
                rel="noopener noreferrer"
                class="ofa-link">WS81479201 OFA Results</a
              >
            </p>
            <p class="registration">
              <a
                href="/img/EzraPrelimOFA.png"
                target="_blank"
                rel="noopener noreferrer"
                class="ofa-link">Additional Test Results</a
              >
            </p>
          </div>
          <div class="parent-card">
            <h3 class="parent-title">Dam</h3>
            <p class="parent-name">
              CH <span class="brand-number">7</span>Sisters N Legado's I Wanna
              Dance, I Wanna Win <span class="call-name">"Mia"</span>
            </p>
            <p class="registration">CHIC #215182</p>
            <p class="registration">
              <a
                href="https://ofa.org/advanced-search/?regnum=WS81418801"
                target="_blank"
                rel="noopener noreferrer"
                class="ofa-link">WS81418801 OFA Results</a
              >
            </p>
          </div>
        </div>
      </section>
      <section class="pedigree-section">
        <h2 class="section-title">Pedigree Explorer</h2>
        <p class="pedigree-intro">
          Explore the full 10-generation pedigree analysis for Ezra × Mia,
          including Wright's cross COI, common ancestor paths, and structural
          findings.
        </p>
        <a href="/ezra-mia-pedigree.html" class="pedigree-link">
          Open Pedigree Explorer →
        </a>
      </section>
      <section class="pedigree-section">
        <h2 class="section-title">Heart Health</h2>
        <p class="pedigree-intro">
          Dilated cardiomyopathy (DCM) affects some adult Great Danes. Read what
          it is, how screening works, and what we do at 7Sisters Farm in
          <a href="/posts/2026-10-21-dcm-in-great-danes"
            >DCM in Great Danes: What Owners and Buyers Should Know</a
          >.
        </p>
      </section>
      <section class="offspring-section">
        <h2 class="section-title">Puppies</h2>
        <p class="pedigree-intro">
          Names and registration numbers are coming. For now, each puppy goes
          by the color of the collar.
        </p>
        <div class="puppies-list">
          {
            puppies.map((p) => (
              <div class="puppy-card">
                <p class="puppy-name">
                  <span
                    aria-hidden="true"
                    style={`display:inline-block;width:0.9em;height:0.9em;border-radius:50%;background:${p.color};margin-right:0.5em;vertical-align:-0.1em;`}
                  />
                  {p.collar} collar — {p.sex}
                </p>
                <p class="puppy-reg">Name and registration number to come</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
