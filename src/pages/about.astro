---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/about.css'

const keywords = [
  'Illinois Great Dane breeders',
  'about Illinois breeders',
  'Central Illinois Great Dane breeders',
  '7Sisters Farm breeders',
  'Illinois dog breeders',
  'Great Dane breeders Illinois',
  'Champaign Illinois breeders',
  'Urbana Illinois breeders',
]
---

<BaseLayout
  title="About Illinois Great Dane Breeders | 7Sisters Farm - Central Illinois"
  description="Meet Dustin and Karen, Illinois Great Dane breeders at 7Sisters Farm. 12+ years experience breeding AKC Great Danes in Central Illinois. Health tested, family raised."
  keywords={keywords}
  image="https://7sistersgreatdanes.com/img/wedding.png"
  canonical="https://7sistersgreatdanes.com/about"
  breadcrumbs={[{ name: 'About Us', path: '/about' }]}
>
  <div class="content">
    <div class="post-title">
      <h1>About Us</h1>
    </div>
    <main class="content-wrapper">
      <section class="hero-section">
        <img
          src="/img/Colorlogo_nobackground.png"
          alt="7Sisters Farm Logo"
          width="300"
          height="auto"
          class="hero-logo"
          loading="lazy"
        />
      </section>
      <section class="about-section">
        <div
          style="display: flex; align-items: center; gap: 30px; margin: 30px 0; flex-wrap: wrap"
        >
          <div
            style="flex: 0 0 auto; text-align: center; min-width: 250px; width: 100%; display: flex; flex-direction: column; align-items: center"
          >
            <img
              src="/img/wedding.png"
              alt="Dustin and Karen with rescue dog Kitty and their first Great Dane Aubrey"
              style="max-width: 300px; width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); margin-bottom: 8px"
            />
            <p style="font-style: italic; color: #666; font-size: 12px; margin: 0">
              Dustin and Karen with Kitty and Aubrey in their wedding tuxedos
              (2012)
            </p>
          </div>
        </div>

        <div class="expertise-section">
          <div class="expertise-grid">
            <div class="expertise-item">
              <h4 class="expertise-name">Dustin</h4>
              <p class="expertise-text">
                I first fell in love with Great Danes while growing up in Iowa.
                I hugged a big, male harlequin at 10 and was immediately their
                biggest fan. My dad, an animal pharmaceutical sales rep with
                Merck, nurtured that fascination by taking me to countless
                hours with veterinarians, watching surgeries, and touring
                agricultural operations. His family had bred German Shepherds,
                but he took me to visit Great Dane breeders and conformation
                shows because that was the breed I had fallen in love with.
              </p>

              <p class="expertise-text" data-expand="dustin" hidden>
                Those early experiences shaped my interest in going into
                science with an interest in genetics, breeding, and
                domestication. While I've since transitioned from active
                research to managing labs and supporting entrepreneurs, I
                leverage those scientific experiences to bring rigor and
                systematic thinking to breeding.
              </p>
              <p class="expertise-text" data-expand="dustin" hidden>
                Our Illinois farm reflects an agricultural approach to
                breeding—multi-generational planning, understanding
                bloodlines and their strengths to make informed breeding
                decisions, and raising animals with purpose. When families
                choose one of our Great Danes, they're getting the benefit of
                both scientific rigor and decades of hands-on experience with
                these magnificent dogs.
              </p>

              <button
                type="button"
                class="read-more-button"
                data-toggle="dustin"
                data-label-more="Read More About Dustin"
                data-label-less="Read Less"
                style="background: none; border: none; color: #bf141c; cursor: pointer; text-decoration: underline; font-size: 16px; margin-top: 15px; margin-bottom: 20px; display: block; padding: 8px 0; min-height: 44px; text-align: left; width: 100%"
              >
                Read More About Dustin
              </button>

              <a
                href="https://scholar.google.com/citations?user=MkPrBuoAAAAJ&hl=en"
                target="_blank"
                rel="noopener noreferrer"
                class="expertise-link"
              >
                View Research Profile →
              </a>
            </div>

            <div class="expertise-item">
              <h4 class="expertise-name">Karen</h4>
              <p class="expertise-text">
                My love of dogs started early. My parents bred dachshunds, I
                competed in 4-H obedience, and as a kid I worked at a
                veterinary clinic, where I got hands-on experience with animal
                care and health problems. I came to Great Danes through my
                husband Dustin and have been devoted to them ever since.
              </p>

              <p class="expertise-text" data-expand="karen" hidden>
                Those years with dachshunds and at the clinic shaped how I
                approach responsible breeding. As a litigation attorney, I
                write comprehensive contracts that protect both families and
                our dogs, covering health, breeding, and ongoing support.
              </p>
              <p class="expertise-text" data-expand="karen" hidden>
                For over 20 years, I've raised money for Blood Cancer United
                and mentored people through its Man and Woman of the Year
                program. Good mentoring means staying with someone through the
                hard parts, and I treat our puppy families the same way. Call
                me, or Dustin, any time, for the whole life of your dog.
              </p>

              <button
                type="button"
                class="read-more-button"
                data-toggle="karen"
                data-label-more="Read More About Karen"
                data-label-less="Read Less"
                style="background: none; border: none; color: #bf141c; cursor: pointer; text-decoration: underline; font-size: 16px; margin-top: 15px; margin-bottom: 20px; display: block; padding: 8px 0; min-height: 44px; text-align: left; width: 100%"
              >
                Read More About Karen
              </button>
            </div>
          </div>
        </div>

        <div class="read-more-section">
          <a href="/posts/2025-06-23-more-than-show-and-go" class="read-more-link">
            Read more about our journey →
          </a>
        </div>
      </section>

      <section class="philosophy-section">
        <div class="cta-section">
          <a href="/BreedingPhilosophy" class="cta-button">
            Learn More About Our Philosophy
          </a>
        </div>
      </section>

      <section class="farm-section">
        <div class="cta-section">
          <a href="/Farm" class="cta-button"> Discover Our Farm's Story </a>
        </div>
      </section>

      <section class="contact-section">
        <div class="cta-section">
          <a href="/contact" class="cta-button"> Contact Us </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    'button[data-toggle]',
  )

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const name = button.dataset.toggle
      const paragraphs = document.querySelectorAll<HTMLElement>(
        `[data-expand="${name}"]`,
      )
      const willExpand = paragraphs[0]?.hidden ?? false

      paragraphs.forEach(p => {
        p.hidden = !willExpand
      })
      button.textContent = willExpand
        ? button.dataset.labelLess ?? ''
        : button.dataset.labelMore ?? ''
    })
  })
</script>
