---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PointScheduleMap from '../../../islands/point-schedule/PointScheduleMap'
import PointScheduleSchema from '../../../components/PointScheduleSchema.astro'
import '../../../styles/point-schedule.css'
import {
  pointsForBreed,
  slugifyBreed,
  ALL_OTHER_BREEDS,
  breedLabel,
} from '../../../lib/pointSchedule2026'
import { loadPointScheduleData } from '../../../lib/pointScheduleServer'
import { loadBreedFacts } from '../../../lib/breedFactsServer'

export function getStaticPaths() {
  const scheduleData = loadPointScheduleData()
  return scheduleData.breeds.map(breed => ({
    params: { slug: slugifyBreed(breed) },
    props: { breed },
  }))
}

const { breed } = Astro.props as { breed: string }
const scheduleData = loadPointScheduleData()
const EFFECTIVE_DATE = scheduleData.effectiveDate
const slug = slugifyBreed(breed)
const isCatchAll = breed === ALL_OTHER_BREEDS

const BREED_DIVISIONS = scheduleData.divisions.map(division => ({
  id: division.id,
  states: division.states,
  points: pointsForBreed(division, breed)!,
}))

const displayName = breedLabel(breed)
const breedFact = loadBreedFacts()[breed]

const breedLinks = scheduleData.breeds
  .filter(b => b !== breed)
  .map(b => ({
    name: b,
    slug: slugifyBreed(b),
  }))

const keywords = [
  'AKC point schedule',
  `${displayName} point schedule`,
  '2026 point schedule',
  'dog show points needed for major',
  'AKC conformation divisions',
  `${displayName} majors`,
]
---

<BaseLayout
  title={`2026 AKC ${displayName} Point Schedule by Division | 7Sisters Farm`}
  description={`Interactive map of the AKC's 2026 point schedule for ${displayName}: how many dogs and bitches are needed for a major in every division, effective ${EFFECTIVE_DATE}.`}
  keywords={keywords}
  canonical={`https://7sistersgreatdanes.com/AKCPointSchedule/breed/${slug}`}
  breadcrumbs={[
    { name: 'AKC Point Schedule', path: '/AKCPointSchedule' },
    { name: displayName, path: `/AKCPointSchedule/breed/${slug}` },
  ]}
>
  <PointScheduleSchema
    slot="head"
    breed={displayName}
    pageUrl={`https://7sistersgreatdanes.com/AKCPointSchedule/breed/${slug}`}
    effectiveDate={EFFECTIVE_DATE}
    sourceUrl={scheduleData.sourceUrl}
    sourceCheckedDate={scheduleData.sourceCheckedDate}
    breedFact={breedFact}
  />
  <div class="content">
    <div class="post-title">
      <h1>2026 AKC {displayName} Point Schedule</h1>
    </div>
    <main class="content-wrapper">
      <section>
        {
          isCatchAll ? (
            <p>
              Tap a state below to see what it takes for a major there —
              defaults to this AKC catch-all, search any breed to switch.
            </p>
          ) : (
            <p>
              Tap a state below to see what it takes for a major there —
              defaults to {breed}, search any breed to switch.
            </p>
          )
        }
        <details class="ps-intro-details">
          <summary class="ps-details-summary">What am I looking at?</summary>
          {
            isCatchAll ? (
              <p>
                "All other breeds and varieties" is the AKC's catch-all
                division-points bucket for breeds and varieties that aren't
                individually broken out in the point schedule. This covers the
                schedule effective <strong>{EFFECTIVE_DATE}</strong>. Hover or
                focus a state to see the minimum dogs and bitches needed for a
                3-point major there; click or tap it for that division's full
                1-through-5-point breakdown (3, 4, and 5-point wins are majors).
              </p>
            ) : (
              <p>
                The AKC redraws how many dogs you need to beat for a major every
                year, division by division. This covers the schedule effective{' '}
                <strong>{EFFECTIVE_DATE}</strong>. Hover or focus a state to see
                the minimum dogs and bitches needed for a 3-point major there;
                click or tap it for that division's full 1-through-5-point
                breakdown (3, 4, and 5-point wins are majors).
              </p>
            )
          }
          <p>
            Looking for a different breed? The breed field above the map
            searches all {scheduleData.breeds.length} AKC breeds and varieties, or
            see the <a href="#breed-index">full breed index</a>.
          </p>
          <p>
            <em
              >AKC point schedules can be revised — always confirm the current
              numbers at <a
                href={scheduleData.sourceUrl}
                target="_blank"
                rel="noopener noreferrer">akc.org</a
              > before entering a show. Information last accessed from the AKC's all-divisions
              schedule on <strong>{scheduleData.sourceCheckedDate}</strong>.</em
            >
          </p>
        </details>
      </section>

      <section aria-label="Interactive point schedule map">
        <PointScheduleMap
          client:load
          initialBreed={breed}
          breedIndexHref="#breed-index"
          renderFullTable
          initialFactsBreed={breed}
          initialDivisions={BREED_DIVISIONS}
          initialBreedFact={breedFact}
        />
      </section>

      <section style="margin-top: 2.5rem">
        <details class="ps-breed-index" id="breed-index">
          <summary class="section-title ps-details-summary">
            Browse the schedule for every breed
          </summary>
          <p>
            Every other AKC breed and variety ({breedLinks.length} in total) has its
            own page with the full 2026 schedule and the same interactive map, defaulted
            to that breed.
          </p>
          <ul class="ps-breed-index-list">
            {
              breedLinks.map(({ name, slug: breedSlug }) => (
                <li>
                  <a href={`/AKCPointSchedule/breed/${breedSlug}`}>{name}</a>
                </li>
              ))
            }
          </ul>
        </details>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  function openBreedIndexIfTargeted() {
    if (window.location.hash !== '#breed-index') return
    const el = document.getElementById('breed-index')
    if (!(el instanceof HTMLDetailsElement)) return
    el.open = true
    const scrollToIt = () => el.scrollIntoView({ block: 'start' })
    // The browser's native fragment scroll fires before/without accounting for
    // the details expanding, and on a fresh page load the interactive map
    // above is still hydrating (async data fetch) and growing taller — so
    // re-scroll ourselves, retrying until that settles.
    requestAnimationFrame(scrollToIt)
    setTimeout(scrollToIt, 400)
    setTimeout(scrollToIt, 1200)
  }
  openBreedIndexIfTargeted()
  window.addEventListener('hashchange', openBreedIndexIfTargeted)
</script>
