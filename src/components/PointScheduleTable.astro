---
import {
  STATE_ABBREVIATIONS,
  MAJOR_POINT_KEYS,
  type BreedPoints,
  type PointLevels,
} from '../lib/pointSchedule2026'

interface Props {
  breed: string
  divisions: { id: number; states: string[]; points: BreedPoints }[]
}

const { breed, divisions } = Astro.props

const pointRows: { key: keyof PointLevels; label: string }[] = [
  { key: 'onePoint', label: '1 pt' },
  { key: 'twoPoint', label: '2 pt' },
  { key: 'threePoint', label: '3 pt' },
  { key: 'fourPoint', label: '4 pt' },
  { key: 'fivePoint', label: '5 pt' },
]
---

<div style="overflow-x: auto">
  <table class="ps-full-table">
    <caption class="ps-visually-hidden"
      >2026 AKC {breed} point schedule, points needed for a major by division,
      dogs and bitches</caption
    >
    <thead>
      <tr>
        <th scope="col" rowspan="2">Division</th>
        <th scope="col" rowspan="2">States</th>
        <th scope="col" colspan="5">Dogs</th>
        <th scope="col" colspan="5">Bitches</th>
      </tr>
      <tr>
        {pointRows.map(row => <th scope="col">{row.label}</th>)}
        {pointRows.map(row => <th scope="col">{row.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        divisions.map(division => (
          <tr>
            <th scope="row">{division.id}</th>
            <td>
              {division.states
                .map(s => STATE_ABBREVIATIONS[s] ?? s)
                .join(', ')}
            </td>
            {pointRows.map(row => (
              <td
                class={
                  (MAJOR_POINT_KEYS as readonly string[]).includes(row.key)
                    ? 'ps-major-cell'
                    : ''
                }
              >
                {division.points.dogs[row.key]}
              </td>
            ))}
            {pointRows.map(row => (
              <td
                class={
                  (MAJOR_POINT_KEYS as readonly string[]).includes(row.key)
                    ? 'ps-major-cell'
                    : ''
                }
              >
                {division.points.bitches[row.key]}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="ps-legend-caption">Bold columns (3, 4, 5 pt) are majors.</p>

<style>
  .ps-full-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .ps-full-table th,
  .ps-full-table td {
    border: 1px solid var(--ps-border, rgba(0, 0, 0, 0.15));
    padding: 0.4rem 0.6rem;
    text-align: center;
  }
  .ps-full-table th[scope='row'] {
    text-align: left;
  }
  .ps-full-table td:nth-child(2) {
    text-align: left;
  }
  .ps-major-cell {
    font-weight: 700;
  }
</style>
